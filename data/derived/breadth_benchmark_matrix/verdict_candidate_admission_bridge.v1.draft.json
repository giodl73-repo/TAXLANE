    {
      "dimension": "coverage_and_fair_access",
      "gate_id": "verdict-coverage-access",
      "required_evidence": ["access_and_distribution", "equity_and_incidence", "exclusion_delay_and_burden"]
    },
    {
      "dimension": "trust",
      "gate_id": "verdict-trust",
      "required_evidence": ["exact_source_and_candidate_version", "source_custody", "assumptions", "role_review", "correction_path", "claim_boundary"]
    }
  ],
  "admission_rules": {
    "all_seven_dimensions_applicable_for_lane_2_candidate": true,
    "allowed_gate_dispositions": ["required_ready", "required_blocked"],
    "required_ready_requires_evidence_path": true,
    "required_blocked_requires_successor_owner_and_blocking_gate": true,
    "failed_or_unresolved_floor_blocks_promotion": true,
    "numeric_score_threshold_used": false,
    "lower_cost_requires_compatible_objective_and_existing_savings_gates": true
  },
  "iteration_levels": [
    "analytical_refresh",
    "operational_response",
    "outcome_learning",
    "fiscal_rebalancing"
  ],
  "implementation_decision": {
    "new_rust_interface_required": false,
    "new_shared_crate_required": false,
    "duplicate_taxlane_scorer_required": false,
    "reuse_core_m_candidate_gate_review": true,
    "reuse_adaptive_rate_contract": true
  },
  "claim_booleans": {
    "reuse_mapping_accepted": true,
    "candidate_admitted": false,
    "target_cost_changed": false,
    "allocation_changed": false,
    "savings_admitted": false,
    "solver_run_performed": false,
    "rate_changed_or_published": false,
    "public_release_authorized": false
  },
  "public_warning": "A VERDICT assessment organizes evidence. It does not select a candidate, establish causality, prove a lower lifecycle price, authorize spending, admit savings, change an allocation, or publish a tax rate."
