    "path": "docs/framework/capability-assessment.md",
    "profile": "VERDICT",
    "dimensions": [
      "value",
      "effectiveness",
      "resilience",
      "deliverability",
      "iteration",
      "coverage_and_fair_access",
      "trust"
    ]
  },
  "scored_object_boundary": {
    "accepted_for_candidate_admission": "candidate",
    "context_only": ["program_capability", "current_system"],
