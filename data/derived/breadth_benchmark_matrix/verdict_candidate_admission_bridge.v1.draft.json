    "annual_update_contract": "data/derived/breadth_benchmark_matrix/deterministic_annual_update_simulator_contract.v1.draft.json"
  },
  "dimension_gate_map": [
    {
      "dimension": "value",
      "gate_id": "verdict-value",
      "required_evidence": ["whole_system_lifecycle_cost", "useful_outcome_denominator", "implementation_and_transition_cost", "compatible_comparison"]
    },
    {
      "dimension": "effectiveness",
      "gate_id": "verdict-effectiveness",
      "required_evidence": ["candidate_specific_official_effect", "declared_service_outcome", "current_baseline"]
    },
    {
      "dimension": "resilience",
      "gate_id": "verdict-resilience",
      "required_evidence": ["continuity_floor", "recovery_floor", "stress_path"]
    },
    {
      "dimension": "deliverability",
      "gate_id": "verdict-deliverability",
      "required_evidence": ["authority", "financing_role", "workforce_and_capacity", "procurement_and_schedule", "transition_plan"]
    },
    {
      "dimension": "iteration",
      "gate_id": "verdict-iteration",
      "required_evidence": ["observation_cadence", "response_authority", "outcome_review", "rollback_or_retirement_trigger", "successor_handling"]
