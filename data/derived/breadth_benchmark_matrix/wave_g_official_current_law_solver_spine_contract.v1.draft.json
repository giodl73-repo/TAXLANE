  "purpose": "Define Wave G as construction and admission of an official FY2025-FY2035 current-law federal fiscal spine before any real reform delta or public solver output is allowed.",
  "sequencing_rationale": "A reform cannot be scored reproducibly until one source-custodied current-law topline spine fixes the baseline horizon, sign conventions, financing residual, and debt-interest lineage. Wave G closes that prerequisite; later reform scoring remains a separate downstream wave.",
  "scope": {
    "baseline_year": 2025,
    "projection_years": [2026, 2027, 2028, 2029, 2030, 2031, 2032, 2033, 2034, 2035],
    "required_years": [2025, 2026, 2027, 2028, 2029, 2030, 2031, 2032, 2033, 2034, 2035],
    "unit": "millions_usd_unrounded_source_precision",
    "grain": "federal_topline_current_law",
    "baseline_actual_bridge_must_be_explicit": true,
    "single_projection_vintage_required": true,
    "cross_source_stitching_without_bridge_prohibited": true,
    "interpolation_prohibited": true,
    "optimization_allowed": false
  },
  "required_annual_fields": [
    "fiscal_year",
    "actual_or_projection",
    "source_id",
    "source_vintage",
    "gdp_musd",
    "total_receipts_musd",
    "primary_outlays_musd",
    "net_interest_musd",
    "total_outlays_musd",
    "primary_deficit_musd",
    "total_deficit_musd",
    "other_financing_and_timing_musd",
    "debt_held_by_public_end_musd",
    "average_interest_rate_percent"
  ],
  "required_identities": {
    "total_outlays": "primary_outlays_musd + net_interest_musd",
    "primary_deficit": "primary_outlays_musd - total_receipts_musd",
    "total_deficit": "total_outlays_musd - total_receipts_musd",
    "deficit_components": "primary_deficit_musd + net_interest_musd",
    "debt_rollforward": "prior_debt_held_by_public_end_musd + total_deficit_musd + other_financing_and_timing_musd",
    "sign_convention": "positive deficits are financing needs; negative values are surpluses or debt-reducing financing adjustments",
    "unrounded_arithmetic_controls": true,
    "explicit_rounding_line_required_if_public_values_are_rounded": true
  },
  "source_admission_requirements": [
    "official publisher or official publisher-maintained repository",
    "local raw-byte custody",
    "retrieval date",
    "byte count and SHA-256",
    "source vintage",
    "field-level extraction mapping",
    "baseline actual versus projection labels",
