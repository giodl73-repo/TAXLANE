  "international_comparator_target_rubric_path": "data/derived/breadth_benchmark_matrix/international_comparator_target_rubric.v1.draft.json",
  "purpose": "Define how parallel lane agents may produce lane-depth and public-explainability packets without making rates, savings, target-cost, solver, waste, fraud, technology-savings, or balanced-budget claims.",
  "parallelization_rules": {
    "one_lane_per_agent": true,
    "one_clean_worktree_per_lane": true,
    "agents_may_not_share_edit_targets": true,
    "integration_agent_required_after_each_wave": true,
    "parallel_source_value_scouts_allowed": true,
    "serial_validator_integration_required": true,
    "workstream_agents_may_not_flip_gates": true,
    "merge_order": "lane_branch_then_integration_pointer",
    "normative_target_choices_require_review": true,
    "policy_mechanism_design_requires_review": true,
    "outcome_floor_threshold_choices_require_review": true,
    "external_requests_allowed": false,
    "public_claims_allowed": false
  },
  "standard_agent_work_order": {
    "required_inputs_to_read": [
      "data/derived/breadth_benchmark_matrix/program_lane_target_cost_contract.v1.draft.json",
      "data/derived/breadth_benchmark_matrix/international_comparator_target_rubric.v1.draft.json",
      "data/derived/breadth_benchmark_matrix/global_country_comparison_coverage.v1.draft.json",
      "data/derived/breadth_benchmark_matrix/lane_depth_explainability_tracker.v1.draft.json",
      "docs/research/2026-06-23-balance-rule-guardrail-spec.md",
      "docs/research/2026-06-24-rate-adjustment-operating-model.md"
    ],
    "required_outputs_per_lane": [
      "lane_depth_card_or_overlay_card",
      "schema",
      "public_reader",
      "lane_readiness_row_update",
      "explicit_blockers",
      "rust_validator",
      "focused_test",
      "pulse_note"
    ],
    "required_public_questions": [
      "What does this lane do?",
      "What are taxpayers paying now?",
      "Who is served or protected?",
      "What outcomes matter before any lower-cost scenario is admissible?",
      "What would count as overspending, underfunding, or only a review-needed signal?",
      "What can technology change, and what transition risks must be paid for?",
      "What evidence is still missing?",
      "What claims are blocked?"
    ],
    "required_claim_firewall": [
      "not_a_solver_run",
      "not_target_cost_selection",
      "not_rate_calculation",
      "not_public_rate_card",
      "not_tax_proposal",
      "not_savings_estimate",
      "not_waste_finding",
      "not_fraud_finding",
      "not_department_cut_instruction",
      "not_technology_savings_claim",
      "not_balanced_budget_claim"
    ]
  },
  "parallel_blocker_workstreams": [
    {
      "workstream_id": "current_law_path_extraction",
      "max_parallel_agents": 3,
      "primary_blockers": ["complete FY2025-FY2035 lane current-law paths", "general-fund versus federal-fund boundary", "trust-fund path reconciliation"],
      "agent_allowed_outputs": ["candidate source packets", "candidate value/null extraction notes", "candidate reader text", "validator patch proposal"],
      "integration_required_before_gate_change": true,
      "blocked_outputs": ["solver input", "rate calculation", "savings estimate", "balanced-budget claim"]
    },
    {
      "workstream_id": "health_medicare_hi_bridge",
      "max_parallel_agents": 2,
      "primary_blockers": ["Medicare HI calendar-to-fiscal bridge", "OMB/CMS/Treasury perimeter reconciliation", "health component current-law split"],
      "agent_allowed_outputs": ["candidate bridge evidence", "timing/perimeter diagnostics", "candidate reader text", "validator patch proposal"],
      "integration_required_before_gate_change": true,
      "blocked_outputs": ["HI solver yield", "health solver row", "rate bridge", "savings estimate"]
    },
    {
      "workstream_id": "receipt_base_rate_bridge",
      "max_parallel_agents": 2,
      "primary_blockers": ["matched legal/economic receipt bases", "payer universe", "incidence and distribution", "administration burden"],
      "agent_allowed_outputs": ["candidate base inventory", "source-overlap diagnostics", "candidate reader text", "validator patch proposal"],
      "integration_required_before_gate_change": true,
      "blocked_outputs": ["statutory rate", "effective rate", "public rate card", "tax proposal"]
    },
    {
      "workstream_id": "outcome_floor_values",
      "max_parallel_agents": 3,
      "primary_blockers": ["threshold rationale", "baseline observed values", "policy and stress floor values", "pass/fail evidence"],
      "agent_allowed_outputs": ["candidate floor-value packets", "source custody notes", "candidate reader text", "validator patch proposal"],
      "integration_required_before_gate_change": true,
      "blocked_outputs": ["floor passage", "lower-cost scenario admissibility", "target cost", "department-cut instruction"]
    },
    {
      "workstream_id": "scenario_pack_prep",
      "max_parallel_agents": 3,
      "primary_blockers": ["component policy paths", "behavior and transition costs", "score provenance", "overlay non-additivity"],
      "agent_allowed_outputs": ["candidate component scenario outlines", "split-lane boundary notes", "candidate reader text", "validator patch proposal"],
      "integration_required_before_gate_change": true,
      "blocked_outputs": ["scored scenario", "federal effect", "gross savings", "net savings"]
    }
  ],
  "central_integration_protocol": {
    "parallel_agents_recommend_only": true,
    "main_integration_updates_machine_artifacts": true,
    "run_required_validation_after_each_integrated_slice": true,
    "public_outputs_remain_blocked_until_upstream_gates_pass": true,
    "max_active_agent_workstreams": 3
  },
  "assignment_waves": [
    {"wave_id": "wave_1_public_topline", "max_parallel_agents": 3, "lane_ids": ["health-medicare", "social-security", "national-defense"], "integration_required": true, "rationale": "Highest public salience and largest risk of premature claims."},
    {"wave_id": "wave_2_human_services", "max_parallel_agents": 3, "lane_ids": ["income-security-family", "education-workforce", "veterans"], "integration_required": true, "rationale": "Human-service lanes need clear served-population and floor language."},
    {"wave_id": "wave_3_public_goods", "max_parallel_agents": 3, "lane_ids": ["disaster-resilience", "justice-courts-public-safety", "science-energy-environment"], "integration_required": true, "rationale": "Public-good lanes require federalism, resilience, and component-separation boundaries."},
    {"wave_id": "wave_4_component_and_pilot", "max_parallel_agents": 3, "lane_ids": ["agriculture", "international-affairs", "transportation-infrastructure"], "integration_required": true, "rationale": "Component-heavy lanes and the transportation pilot need consistency checks before deeper modeling."},
    {"wave_id": "wave_5_overlays", "max_parallel_agents": 3, "lane_ids": ["revenue-solvency", "payment-integrity", "net-interest"], "integration_required": true, "rationale": "Overlays are non-additive or endogenous and must be checked last against lane outputs."}
  ],
  "integration_review_checklist": [
    "all_15_analytical_lanes_present_once",
    "17_budget_rows_not_confused_with_15_analytical_lanes",
    "revenue_solvency_and_payment_integrity_remain_non_additive_overlays",
