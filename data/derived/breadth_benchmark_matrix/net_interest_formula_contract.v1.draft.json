  "purpose": "Define the endogenous net-interest formula contract required before the deterministic solver may publish debt, interest, rate, or balanced-budget outputs.",
  "formula_identity": {
    "primary_balance": "total_federal_receipts - primary_outlays",
    "deficit": "primary_outlays + net_interest - total_federal_receipts",
    "debt_t": "debt_t_minus_1 + deficit_t + explicit_other_financing_t",
    "net_interest_t": "sum_over_maturity_buckets(debt_stock_bucket_t_minus_1 * effective_rate_bucket_t) + new_borrowing_interest_t - interest_receipts_t",
    "incremental_feedback_net_interest_t": "(average_rate_t * beginning_debt_delta_t + average_rate_t * exposure_fraction_t * incremental_primary_financing_t) / (1 - average_rate_t * exposure_fraction_t)",
    "iteration_rule": "After any primary-balance change, recompute deficit, debt, and subsequent net interest; recompute maturity-bucket debt stock when using the full-stock maturity model."
  },
